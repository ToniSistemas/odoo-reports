<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Definition -->
    <record id="action_report_invoice_pdf" model="ir.actions.report">
        <field name="name">Invoice PDF Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_pdf_report.report_invoice_pdf_template</field>
        <field name="report_file">invoice_pdf_report.report_invoice_pdf_template</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Factura - %s' % (object.name)</field>
    </record>

    <!-- QWeb Template for PDF -->
    <template id="report_invoice_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .invoice-header {
                                text-align: center;
                                margin-bottom: 30px;
                                border-bottom: 2px solid #333;
                                padding-bottom: 20px;
                            }
                            .company-logo {
                                max-height: 100px;
                                margin-bottom: 10px;
                            }
                            .invoice-title {
                                font-size: 28px;
                                font-weight: bold;
                                color: #333;
                                margin-top: 10px;
                            }
                            .info-section {
                                margin-bottom: 30px;
                            }
                            .info-box {
                                border: 1px solid #ddd;
                                padding: 15px;
                                border-radius: 5px;
                                background-color: #f9f9f9;
                            }
                            .info-label {
                                font-weight: bold;
                                color: #555;
                                margin-bottom: 5px;
                            }
                            .info-value {
                                color: #333;
                                margin-bottom: 10px;
                            }
                            .invoice-details {
                                margin-top: 20px;
                            }
                            .details-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 20px;
                            }
                            .details-table th {
                                background-color: #333;
                                color: white;
                                padding: 10px;
                                text-align: left;
                                font-weight: bold;
                            }
                            .details-table td {
                                padding: 10px;
                                border-bottom: 1px solid #ddd;
                            }
                            .amount-section {
                                margin-top: 30px;
                                text-align: right;
                            }
                            .total-amount {
                                font-size: 24px;
                                font-weight: bold;
                                color: #333;
                                margin-bottom: 10px;
                            }
                            .payment-text {
                                font-size: 16px;
                                color: #666;
                                font-style: italic;
                                margin-top: 20px;
                                padding: 15px;
                                background-color: #f0f0f0;
                                border-left: 4px solid #333;
                            }
                        </style>

                        <!-- Header with Logo -->
                        <div class="invoice-header">
                            <t t-if="o.company_id.logo">
                                <img t-att-src="image_data_uri(o.company_id.logo)" class="company-logo" alt="Company Logo"/>
                            </t>
                            <div class="invoice-title">FACTURA</div>
                        </div>

                        <!-- Customer Information -->
                        <div class="row info-section">
                            <div class="col-6">
                                <div class="info-box">
                                    <div class="info-label">Cliente:</div>
                                    <div class="info-value">
                                        <strong><t t-esc="o.partner_id.name"/></strong>
                                    </div>
                                    <t t-if="o.partner_id.street">
                                        <div class="info-label">Dirección:</div>
                                        <div class="info-value">
                                            <t t-esc="o.partner_id.street"/>
                                            <t t-if="o.partner_id.street2">
                                                <br/><t t-esc="o.partner_id.street2"/>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-if="o.partner_id.city">
                                        <div class="info-label">Localidad:</div>
                                        <div class="info-value">
                                            <t t-esc="o.partner_id.city"/>
                                            <t t-if="o.partner_id.state_id">
                                                , <t t-esc="o.partner_id.state_id.name"/>
                                            </t>
                                            <t t-if="o.partner_id.zip">
                                                (<t t-esc="o.partner_id.zip"/>)
                                            </t>
                                        </div>
                                    </t>
                                    <t t-if="o.partner_id.country_id">
                                        <div class="info-label">País:</div>
                                        <div class="info-value">
                                            <t t-esc="o.partner_id.country_id.name"/>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Invoice Information -->
                            <div class="col-6">
                                <div class="info-box">
                                    <div class="info-label">Número de Factura:</div>
                                    <div class="info-value">
                                        <strong><t t-esc="o.name"/></strong>
                                    </div>
                                    <div class="info-label">Fecha de Emisión:</div>
                                    <div class="info-value">
                                        <t t-esc="o.invoice_date.strftime('%d/%m/%Y')" t-if="o.invoice_date"/>
                                    </div>
                                    <div class="info-label">Fecha de Vencimiento:</div>
                                    <div class="info-value">
                                        <t t-esc="o.invoice_date_due.strftime('%d/%m/%Y')" t-if="o.invoice_date_due"/>
                                        <span t-else="">Sin fecha de vencimiento</span>
                                    </div>
                                    <div class="info-label">Estado:</div>
                                    <div class="info-value">
                                        <t t-if="o.payment_state == 'paid'">
                                            <span style="color: green;">Pagado</span>
                                        </t>
                                        <t t-elif="o.payment_state == 'partial'">
                                            <span style="color: orange;">Pago Parcial</span>
                                        </t>
                                        <t t-else="">
                                            <span style="color: red;">No Pagado</span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Invoice Lines -->
                        <div class="invoice-details">
                            <table class="details-table">
                                <thead>
                                    <tr>
                                        <th>Descripción</th>
                                        <th class="text-right">Cantidad</th>
                                        <th class="text-right">Precio Unitario</th>
                                        <th class="text-right">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.invoice_line_ids" t-as="line">
                                        <tr>
                                            <td><t t-esc="line.name"/></td>
                                            <td class="text-right"><t t-esc="line.quantity"/></td>
                                            <td class="text-right">
                                                <t t-esc="'%.2f' % line.price_unit"/>
                                                <t t-esc="o.currency_id.symbol"/>
                                            </td>
                                            <td class="text-right">
                                                <t t-esc="'%.2f' % line.price_subtotal"/>
                                                <t t-esc="o.currency_id.symbol"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- Amount Section -->
                        <div class="amount-section">
                            <div>
                                <strong>Subtotal: </strong>
                                <span t-esc="'%.2f' % o.amount_untaxed"/>
                                <span t-esc="o.currency_id.symbol"/>
                            </div>
                            <div>
                                <strong>Impuestos: </strong>
                                <span t-esc="'%.2f' % o.amount_tax"/>
                                <span t-esc="o.currency_id.symbol"/>
                            </div>
                            <div class="total-amount">
                                <strong>TOTAL: </strong>
                                <span t-esc="'%.2f' % o.amount_total"/>
                                <span t-esc="o.currency_id.symbol"/>
                            </div>
                        </div>

                        <!-- Payment Text -->
                        <div class="payment-text">
                            <t t-if="o.payment_state == 'paid'">
                                He pagado la cantidad total de 
                                <strong><t t-esc="'%.2f' % o.amount_total"/> <t t-esc="o.currency_id.symbol"/></strong>
                                correspondiente a esta factura.
                            </t>
                            <t t-elif="o.payment_state == 'partial'">
                                He pagado parcialmente esta factura. 
                                Importe pendiente: 
                                <strong><t t-esc="'%.2f' % o.amount_residual"/> <t t-esc="o.currency_id.symbol"/></strong>
                            </t>
                            <t t-else="">
                                Reconozco haber recibido esta factura por un importe de 
                                <strong><t t-esc="'%.2f' % o.amount_total"/> <t t-esc="o.currency_id.symbol"/></strong>.
                                El pago se realizará según los términos acordados.
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
