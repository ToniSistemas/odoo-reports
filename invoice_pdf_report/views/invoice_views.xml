<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add button to invoice form view -->
    <record id="view_move_form_inherited" model="ir.ui.view">
        <field name="name">account.move.form.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add the print button in the header next to other buttons -->
            <xpath expr="//header" position="inside">
                <button name="%(invoice_pdf_report.action_report_invoice_pdf)d" 
                        string="Imprimir Reporte PDF" 
                        type="action"
                        class="oe_highlight"
                        attrs="{'invisible': [('move_type', 'not in', ['out_invoice', 'out_refund'])]}"/>
            </xpath>
        </field>
    </record>
</odoo>
